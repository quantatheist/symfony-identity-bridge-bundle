# Illustrative WEB client configuration. These are NOT framework-reserved env names.
# Do not commit real values/secrets. Prefer Symfony Secrets or deployment secrets.
#
# Use native Symfony 8.2 oidc_login:
OIDC_PROVIDER_URI=https://auth.example.test/
# Exact Authentik per-provider metadata URL; needed for a global issuer with scoped discovery:
OIDC_WELL_KNOWN_URL=https://auth.example.test/application/o/web/.well-known/openid-configuration
OIDC_CLIENT_ID=replace-with-web-client-id
# Secret is shown only as a nonfunctional placeholder:
OIDC_CLIENT_SECRET=REPLACE_VIA_SECRET_STORE
#
# Drenso uses OIDC_WELL_KNOWN_URL, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET.
# Existing Teatime-specific OIDC_WEB_* values may be kept instead.
# Do NOT put mobile client credentials or refresh tokens here.
